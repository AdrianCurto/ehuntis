# PostHog Analytics (Client-side telemetry)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase (Server-side multi-device sync)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Service Role (Server-only for feedback persistence and rate-limiting)
SUPABASE_SERVICE_ROLE_KEY=

# Discord Webhook (Private channel for feedback notifications)
DISCORD_WEBHOOK_URL=

# Salt for hashing client IPs without storing raw IP addresses
FEEDBACK_IP_SALT=

